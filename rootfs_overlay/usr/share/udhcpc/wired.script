#!/bin/sh
# shellcheck disable=SC2154  # $interface $ip $subnet $router $dns are set in the environment by udhcpc
# Minimal udhcpc handler for the wired NIC. The stock default.script fails on
# this reduced busybox (no route/mktemp/touch applets), so it never installs the
# default route. Do the essentials with ip: assign IP, install the PRIMARY
# default route (metric 0 -> preferred over WiFi's metric 20), add DNS
# idempotently, one-shot NTP (no RTC).
log=/root/udh_eth.log
echo "$(cat /proc/uptime 2>/dev/null) $1 ip=$ip router=$router subnet=$subnet" >> "$log"
case "$1" in
  bound|renew)
    /sbin/ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    if [ -n "$router" ]; then
      /sbin/ip route replace default via "${router%% *}" dev "$interface" metric 0 2>/dev/null
    fi
    for i in $dns; do
      grep -q "^nameserver $i$" /etc/resolv.conf 2>/dev/null || echo "nameserver $i" >> /etc/resolv.conf
    done
    ( /usr/sbin/ntpd -q -n -p "${router%% *}" -p pool.ntp.org >/root/ntp.log 2>&1 ) &
    ;;
  deconfig)
    /sbin/ifconfig "$interface" 0.0.0.0 2>/dev/null
    ;;
esac
exit 0
