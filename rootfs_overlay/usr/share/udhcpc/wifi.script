#!/bin/sh
# shellcheck disable=SC2154  # $interface $ip $subnet $router $dns are set in the environment by udhcpc
# Minimal udhcpc handler for wlan0 (WiFi). The stock default.script hangs on
# this busybox (no `route` applet + avahi calls). Do the essentials with `ip`:
# assign the lease IP, install a backup default route (higher metric so eth0
# stays primary when both are up), add DNS idempotently, one-shot NTP (no RTC).
log=/root/udh_wlan.log
echo "$(cat /proc/uptime 2>/dev/null) $1 ip=$ip router=$router subnet=$subnet" >> "$log"
case "$1" in
  bound|renew)
    /sbin/ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
    if [ -n "$router" ]; then
      /sbin/ip route replace default via "${router%% *}" dev "$interface" metric 20 2>/dev/null
    fi
    for i in $dns; do
      grep -q "^nameserver $i$" /etc/resolv.conf 2>/dev/null || echo "nameserver $i" >> /etc/resolv.conf
    done
    ( /usr/sbin/ntpd -q -n -p "${router%% *}" -p pool.ntp.org >/root/ntp_wlan.log 2>&1 ) &
    ;;
  deconfig)
    /sbin/ifconfig "$interface" 0.0.0.0 2>/dev/null
    ;;
esac
exit 0
