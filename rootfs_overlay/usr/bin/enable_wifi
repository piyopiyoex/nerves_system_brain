#!/bin/sh
# WiFi bring-up for SHARP Brain PW-SH6 (Nerves port). Analogous to
# enable_wired_lan. USB WiFi dongle (host mode) enumerates as wlan0;
# wpa_supplicant(WPA2) associates, then udhcpc gets a lease via wifi.script
# (the stock default.script hangs on this busybox: no `route` applet + avahi).
# Backgrounded so the erlinit --pre-run-exec caller does not block boot.
log=/root/wifi.log
echo "enable_wifi start uptime=$(cat /proc/uptime 2>/dev/null)" > "$log"
{
    # wait up to 30s for wlan0 (USB enumerate + ath9k_htc firmware load + bind)
    n=0
    while [ ! -e /sys/class/net/wlan0 ] && [ "$n" -lt 30 ]; do sleep 1; n=$((n+1)); done
    if [ ! -e /sys/class/net/wlan0 ]; then
        echo "NO wlan0 after ${n}s; ifaces=$(ls /sys/class/net 2>/dev/null)" >> "$log"
        dmesg 2>/dev/null | grep -iE 'ath9k|9271|rtw|rtl8|mt76|cfg80211|wlan|usb' >> "$log"
        exit 0
    fi
    echo "wlan0 present after ${n}s" >> "$log"

    # clear any stale udhcpc/wpa_supplicant on wlan0 from a previous run
    for p in $(ps 2>/dev/null | grep -E 'udhcpc.*wlan0|wpa_supplicant.*wlan0' | grep -v grep | awk '{print $1}'); do
        kill -9 "$p" 2>/dev/null
    done

    /sbin/ip link set wlan0 up
    rm -f /var/run/wpa_supplicant/wlan0 2>/dev/null
    /usr/sbin/wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf >> "$log" 2>&1
    echo "wpa_supplicant rc=$?" >> "$log"

    # wait up to 20s for association (iw link shows "Connected to") before DHCP
    m=0
    while [ "$m" -lt 20 ]; do
        /usr/sbin/iw wlan0 link 2>/dev/null | grep -q "Connected to" && break
        sleep 1; m=$((m+1))
    done
    echo "assoc wait ${m}s:" >> "$log"; /usr/sbin/iw wlan0 link >> "$log" 2>&1

    /sbin/udhcpc -i wlan0 -b -s /usr/share/udhcpc/wifi.script >> "$log" 2>&1
    echo "udhcpc rc=$?" >> "$log"
    sleep 3
    /sbin/ip addr show wlan0 >> "$log" 2>&1
} </dev/null >>"$log" 2>&1 &
exit 0
