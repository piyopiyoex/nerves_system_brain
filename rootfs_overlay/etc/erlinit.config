# erlinit configuration for SHARP Brain PW-SH6 (bring-up profile)

# Verbose prints during bring-up (silence for production)
-v

# IEx/erl console on the Brain LCD (fbcon). The built-in keyboard feeds tty1.
-c tty1
--warn-unused-tty

# Environment
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# configfs is needed for the USB NCM gadget setup
-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:

# Erlang release search path (no release during bring-up -> erl fallback)
-r /srv/erlang

# Drop to a shell instead of rebooting while bringing the system up
--run-on-exit /bin/sh

# Bring up networking (enable_net = wired USB-Ethernet + WiFi wlan0, both async/backgrounded)
--pre-run-exec /usr/bin/enable_net
