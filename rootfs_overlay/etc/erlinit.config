# SHARP Brain PW-SH6 用 erlinit 設定。
# 現在は実機 bring-up を優先した構成である。各設定の区分は docs/erlinit.md を参照する。

# bring-up: 起動処理の詳細をカーネルログへ出力する。
-v

# bring-up / 実機固有: LCD の fbcon と内蔵キーボードを Erlang コンソールに使用する。
-c tty1
# bring-up: カーネルログが別の tty に出ている場合に警告する。
--warn-unused-tty

# 通常動作: ロケールと名前解決を設定する。
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
# 障害解析: crash dump の出力先と最大出力時間を設定する。
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# 通常動作: USB NCM の構成前に configfs をマウントする。
-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:

# 通常動作: application release を検索する場所を明示する。
# release がない bring-up 環境ではシステムの Erlang runtime を起動する。
-r /srv/erlang

# 通常動作: Erlang 起動前に USB NCM を初期化する。
# 内蔵キーボードの未変換の keymap では入力できない文字があるため、起動時に自動実行する。
--pre-run-exec /usr/bin/enable_ethernet_gadget

# bring-up: Erlang が異常終了した場合は、再起動前に調査用の `/bin/sh` を起動する。
--run-on-exit /bin/sh
