# SHARP Brain PW-SH6 の erlinit bring-up profile。
# 各設定の役割と将来の運用構成との違いは docs/erlinit.md を参照する。

# bring-up: 起動処理の詳細を出力する。
-v

# PW-SH6 / bring-up: LCD の fbcon と内蔵キーボードを Erlang console として使用する。
-c tty1
# bring-up: kernel log が別の tty に出ている場合に警告する。
--warn-unused-tty

# 通常動作: UTF-8 locale、表示言語、Erlang の名前解決設定を指定する。
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
# 障害解析: crash dump の出力先と最大出力時間を指定する。
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# USB NCM 開発用: gadget setup に必要な configfs を mount する。
-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:

# 通常動作: Erlang release の検索場所を指定する。
# release がない bring-up 環境では system の Erlang runtime を使用する。
-r /srv/erlang

# USB の役割は Device Tree で決まる(docs/erlinit.md)。現在配備している imx28-pwsh6.dtb は host 構成
# (有線 LAN / WiFi / BLE / USB Audio)なので、USB NCM gadget(peripheral 構成用)は起動しない。
# peripheral 構成の DTB で開発する場合は次行を有効にし、enable_net を外す:
#--pre-run-exec /usr/bin/enable_ethernet_gadget

# bring-up: Erlang 終了後に調査用 shell を起動する。
--run-on-exit /bin/sh

# Bring up networking (enable_net = wired USB-Ethernet + WiFi wlan0, both async/backgrounded)
--pre-run-exec /usr/bin/enable_net
