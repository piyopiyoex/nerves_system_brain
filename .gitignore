# Buildroot build output (huge, regenerated by create-build.sh)
/o/
/.nerves/

# SD images downloaded from brain-hackers/buildbrain (huge; re-download instead)
/sd/*.img
/sd/*.zip

# Pinned brain-hackers boot assets fetched by scripts/fetch_boot_assets.sh.
# The source and checksums are documented in boot/README.md.
/boot/*
!/boot/README.md
!/boot/imx28-pwsh6-peripheral.dts
!/boot/imx28-pwsh6-peripheral.dtb
!/boot/uEnv.a.txt
!/boot/uEnv.b.txt
!/boot/uEnv.auto-a.txt
!/boot/uEnv.auto-b.txt

# Crash dumps captured from the device — MAY CONTAIN SECRETS (host key bytes,
# cookies, memory contents). Never commit.
*.dump

# Device diagnostic logs (contain MAC addresses / internal state)
/sd/gadget_diag.log

# Original DTB/DTS extracted from the distributed image (redistribution).
# Keep only the *-peripheral patch we author ourselves.
/sd/imx28-pwsh6-working.dtb
/sd/pwsh6-working.dts

# Reference script slurped off the running Brainux device
/reference_enable_ethernet_gadget.sh

# Buildroot build logs (make -C o)
/build*.log
