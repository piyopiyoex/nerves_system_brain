					fsl,pinmux-ids = <0x3101 0x3111>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
					phandle = <0x1c>;
				};

				i2c1@1 {
