					fsl,pinmux-ids = <0x30a1 0x30b1>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
				};

				saif0@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3140 0x3150 0x3160 0x3170>;
					fsl,drive-strength = <0x02>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
					phandle = <0x15>;
				};

				saif0@1 {
