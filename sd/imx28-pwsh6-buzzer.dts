					fsl,pinmux-ids = <0x2071>;
					fsl,drive-strength = <0x02>;
					fsl,pull-up = <0x00>;
				};

				mmc2-sck-cfg@1 {
					reg = <0x01>;
					fsl,pinmux-ids = <0x2100>;
					fsl,drive-strength = <0x02>;
					fsl,pull-up = <0x00>;
				};

				i2c0@0 {
