				mac0@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x4000 0x4010 0x4020 0x4030 0x4040 0x4060 0x4070 0x4080 0x4100>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
				};

				mac0@1 {
					reg = <0x01>;
					fsl,pinmux-ids = <0x4000 0x4010 0x4020 0x4030 0x4040 0x4090 0x40a0 0x4060 0x4070 0x4080 0x40b0 0x40c0 0x4100 0x40e0 0x40f0 0x4050 0x40d0>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
				};

				mac1@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x40f1 0x4091 0x40a1 0x40e1 0x40b1 0x40c1>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
				};

				mmc0-8bit@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x2000 0x2010 0x2020 0x2030 0x2040 0x2050 0x2060 0x2070 0x2080 0x2090 0x20a0>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
					phandle = <0x04>;
				};

				mmc0-4bit@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x2000 0x2010 0x2020 0x2030 0x2080 0x2090 0x20a0>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
				};

				mmc0-cd-cfg@0 {
