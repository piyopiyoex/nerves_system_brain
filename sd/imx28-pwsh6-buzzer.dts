		pwms = <0x26 0x00 0xc350>;
		enable_gpios = <0x1b 0x05 0x00>;
		brightness-levels = <0x00 0x04 0x08 0x10 0x20 0x40 0x80 0xff>;
		default-brightness-level = <0x07>;
	};

	backlight@1 {
