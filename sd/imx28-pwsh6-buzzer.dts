					fsl,drive-strength = <0x02>;
					fsl,pull-up = <0x00>;
					phandle = <0x06>;
				};

				mmc1-4bit@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x01 0x11 0x21 0x31 0x151 0x141 0x191>;
