// buildbrain 2026-03-25-024518 の DTB を基にした本システム向け派生ソース。

/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "SHARP Brain PW-SH6";
	compatible = "sharp,pw-sh6\0sharp,brain\0fsl,imx28";

	chosen {
	};

	aliases {
		ethernet0 = "/ahb@80080000/ethernet@800f0000";
		ethernet1 = "/ahb@80080000/ethernet@800f4000";
		gpio0 = "/apb@80000000/apbh@80000000/pinctrl@80018000/gpio@0";
		gpio1 = "/apb@80000000/apbh@80000000/pinctrl@80018000/gpio@1";
		gpio2 = "/apb@80000000/apbh@80000000/pinctrl@80018000/gpio@2";
		gpio3 = "/apb@80000000/apbh@80000000/pinctrl@80018000/gpio@3";
		gpio4 = "/apb@80000000/apbh@80000000/pinctrl@80018000/gpio@4";
		saif0 = "/apb@80000000/apbx@80040000/saif@80042000";
		saif1 = "/apb@80000000/apbx@80040000/saif@80046000";
		serial0 = "/apb@80000000/apbx@80040000/serial@8006a000";
		serial1 = "/apb@80000000/apbx@80040000/serial@8006c000";
		serial2 = "/apb@80000000/apbx@80040000/serial@8006e000";
		serial3 = "/apb@80000000/apbx@80040000/serial@80070000";
		serial4 = "/apb@80000000/apbx@80040000/serial@80072000";
		spi0 = "/apb@80000000/apbh@80000000/spi@80012000";
		spi1 = "/apb@80000000/apbh@80000000/spi@80014000";
		usbphy0 = "/apb@80000000/apbx@80040000/usbphy@8007c000";
		usbphy1 = "/apb@80000000/apbx@80040000/usbphy@8007e000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,arm926ej-s";
			device_type = "cpu";
			reg = <0x00>;
		};
	};

	apb@80000000 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		reg = <0x80000000 0x80000>;
		ranges;

		apbh@80000000 {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x80000000 0x3c900>;
			ranges;

			interrupt-controller@80000000 {
				compatible = "fsl,imx28-icoll\0fsl,icoll";
				interrupt-controller;
				#interrupt-cells = <0x01>;
				reg = <0x80000000 0x2000>;
				phandle = <0x01>;
			};

			hsadc@80002000 {
				reg = <0x80002000 0x2000>;
				interrupts = <0x0d>;
				dmas = <0x02 0x0c>;
				dma-names = "rx";
				status = "disabled";
			};

			dma-apbh@80004000 {
				compatible = "fsl,imx28-dma-apbh";
				reg = <0x80004000 0x2000>;
				interrupts = <0x52 0x53 0x54 0x55 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x58 0x57 0x56 0x00 0x00>;
				interrupt-names = "ssp0\0ssp1\0ssp2\0ssp3\0gpmi0\0gmpi1\0gpmi2\0gmpi3\0gpmi4\0gmpi5\0gpmi6\0gmpi7\0hsadc\0lcdif\0empty\0empty";
				#dma-cells = <0x01>;
				dma-channels = <0x10>;
				clocks = <0x03 0x19>;
				phandle = <0x02>;
			};

			perfmon@80006000 {
				reg = <0x80006000 0x800>;
				interrupts = <0x1b>;
				status = "disabled";
			};

			nand-controller@8000c000 {
				compatible = "fsl,imx28-gpmi-nand";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				reg = <0x8000c000 0x2000 0x8000a000 0x2000>;
				reg-names = "gpmi-nand\0bch";
				interrupts = <0x29>;
				interrupt-names = "bch";
				clocks = <0x03 0x32>;
				clock-names = "gpmi_io";
				assigned-clocks = <0x03 0x0d>;
				assigned-clock-parents = <0x03 0x0a>;
				dmas = <0x02 0x04>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			spi@80010000 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x80010000 0x2000>;
				interrupts = <0x60>;
				clocks = <0x03 0x2e>;
				dmas = <0x02 0x00>;
				dma-names = "rx-tx";
				status = "okay";
				compatible = "fsl,imx28-mmc";
				pinctrl-names = "default";
				pinctrl-0 = <0x04 0x05 0x06>;
				bus-width = <0x08>;
				wp-gpios = <0x07 0x0c 0x00>;
				vmmc-supply = <0x08>;
			};

			spi@80012000 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x80012000 0x2000>;
				interrupts = <0x61>;
				clocks = <0x03 0x2f>;
				dmas = <0x02 0x01>;
				dma-names = "rx-tx";
				status = "okay";
				compatible = "fsl,imx28-mmc";
				pinctrl-names = "default";
				pinctrl-0 = <0x09 0x0a 0x0b>;
				bus-width = <0x04>;
			};

			spi@80014000 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x80014000 0x2000>;
				interrupts = <0x62>;
				clocks = <0x03 0x30>;
				dmas = <0x02 0x02>;
				dma-names = "rx-tx";
				status = "disabled";
				compatible = "fsl,imx28-spi";
				pinctrl-names = "default";
				pinctrl-0 = <0x0c>;
				clock-frequency = <0xf42400>;

				slcd@0 {
					reg = <0x00>;
					status = "okay";
					compatible = "brain,st7586";
					spi-max-frequency = <0xf42400>;
					reset-gpios = <0x07 0x12 0x00>;
					rotation = <0xb4>;
				};
			};

			spi@80016000 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x80016000 0x2000>;
				interrupts = <0x63>;
				clocks = <0x03 0x31>;
				dmas = <0x02 0x03>;
				dma-names = "rx-tx";
				status = "disabled";
			};

			pinctrl@80018000 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "fsl,imx28-pinctrl\0simple-bus";
				reg = <0x80018000 0x2000>;
				pinctrl-names = "default";
				pinctrl-0 = <0x0d 0x0e 0x0f>;

				gpio@0 {
					compatible = "fsl,imx28-gpio\0fsl,mxs-gpio";
					reg = <0x00>;
					interrupts = <0x7f>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x12>;
				};

				gpio@1 {
					compatible = "fsl,imx28-gpio\0fsl,mxs-gpio";
					reg = <0x01>;
					interrupts = <0x7e>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
				};

				gpio@2 {
					compatible = "fsl,imx28-gpio\0fsl,mxs-gpio";
					reg = <0x02>;
					interrupts = <0x7d>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x07>;
				};

				gpio@3 {
					compatible = "fsl,imx28-gpio\0fsl,mxs-gpio";
					reg = <0x03>;
					interrupts = <0x7c>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x1b>;
				};

				gpio@4 {
					compatible = "fsl,imx28-gpio\0fsl,mxs-gpio";
					reg = <0x04>;
					interrupts = <0x7b>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x13>;
				};

				duart@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3102 0x3112>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				duart@1 {
					reg = <0x01>;
					fsl,pinmux-ids = <0x3022 0x3032>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
					phandle = <0x1e>;
				};

				duart-4pins@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3022 0x3032 0x3002 0x3012>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				gpmi-nand@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x00 0x10 0x20 0x30 0x40 0x50 0x60 0x70 0x100 0x140 0x180 0x190 0x1a0 0x1b0 0x1c0>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				gpmi-status-cfg@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x180 0x190 0x1c0>;
					fsl,drive-strength = <0x02>;
				};

				auart0@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3000 0x3010 0x3020 0x3030>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart0-2pins@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3000 0x3010>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart1@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3040 0x3050 0x3060 0x3070>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart1-2pins@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3040 0x3050>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart2-2pins@0 {
					reg = <0x00>;
