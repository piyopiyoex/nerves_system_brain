					fsl,drive-strength = <0x02>;
					fsl,pull-up = <0x00>;
					phandle = <0x0b>;
				};

				mmc2-4bit@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x2041 0x20c1 0x20d1 0x2051 0x2061 0x3041 0x2071>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
				};

				mmc2-4bit@1 {
					reg = <0x01>;
					fsl,pinmux-ids = <0x2100 0x2110 0x2120 0x2130 0x2141 0x2151 0x3041>;
					fsl,drive-strength = <0x01>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x01>;
				};

				mmc2-cd-cfg@0 {
