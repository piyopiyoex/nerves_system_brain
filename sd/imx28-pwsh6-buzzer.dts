					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart2-2pins@1 {
					reg = <0x01>;
					fsl,pinmux-ids = <0x3080 0x3090>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart2-pins@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x3080 0x3090 0x30a0 0x30b0>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart3@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x30c0 0x30d0 0x30e0 0x30f0>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart3-2pins@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x2121 0x2131>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart3-2pins@1 {
					reg = <0x01>;
					fsl,pinmux-ids = <0x30c0 0x30d0>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart4@0 {
					reg = <0x00>;
					fsl,pinmux-ids = <0x2181 0x2191>;
					fsl,drive-strength = <0x00>;
					fsl,voltage = <0x01>;
					fsl,pull-up = <0x00>;
				};

				auart4@1 {
