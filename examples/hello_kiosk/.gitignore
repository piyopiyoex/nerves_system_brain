# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
hello_kiosk_brain-*.tar

# Legacy custom SSH material is no longer used by NervesSSH, but keep it
# ignored so existing worktrees never expose old private keys.
/priv/ssh/ssh_host_*
/priv/ssh/authorized_keys

# Cross-compile test binaries (Phase 2 artifacts; keep only the .c source).
/test/hello_static
/test/hello_dynamic

# Local RNG/debug dumps captured from the device.
*.dump

# Application-specific ARMv5 helper generated by the Makefile.
/priv/bin/devmem
