# /etc/wpa_supplicant.conf  —  SHARP Brain PW-SH6 (Nerves) 用 WiFi 設定雛形(3拠点)
#
# 複数の network={} を書いておくと、wpa_supplicant はその場で電波が届く
# ネットワークに自動接続します。3拠点分を登録しておけば、どの拠点に持って
# 行っても自動でつながります(同時に複数届く場合は priority が大きいものを優先)。
#
# 使い方:
#   1. 各 network={} の ssid= と psk= を、その拠点の WiFi に書き換える
#      (ssid=ネットワーク名、psk=パスワード。どちらも " " で囲む)
#   2. 使わない拠点は、その network={} ブロックを丸ごと削除 or 行頭に # を付ける
#   3. これで完了。起動時に erlinit --pre-run-exec /usr/bin/enable_net が
#      enable_wired_lan と enable_wifi を自動起動し、wlan0 は wpa_supplicant で
#      関連付け→udhcpc(wifi.script)で DHCP 取得する（手動操作は不要）。
#
# パスワードを平文で置きたくない場合:
#   母艦で  wpa_passphrase "SSID名" "パスワード"  を実行し、出力の psk=(ハッシュ値、
#   引用符なし)を該当 network の psk 行と差し替える。

ctrl_interface=/var/run/wpa_supplicant
update_config=1
# 5GHz(11ac)の規制ドメイン。日本は JP。
country=JP

# ===== 拠点1 =====
network={
    ssid="拠点1のSSID"
    psk="拠点1のパスワード"
    key_mgmt=WPA-PSK
    priority=10
    # 隠しSSID(ステルス)なら次行を有効化:
    #scan_ssid=1
}

# ===== 拠点2 =====
network={
    ssid="拠点2のSSID"
    psk="拠点2のパスワード"
    key_mgmt=WPA-PSK
    priority=10
    #scan_ssid=1
}

# ===== 拠点3 =====
network={
    ssid="拠点3のSSID"
    psk="拠点3のパスワード"
    key_mgmt=WPA-PSK
    priority=10
    #scan_ssid=1
}

